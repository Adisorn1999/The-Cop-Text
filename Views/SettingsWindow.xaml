<Window x:Class="WpfApp1.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Settings"
        Width="980"
        Height="680"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">

    <Grid x:Name="RootGrid"
          Background="{DynamicResource WindowBackground}">

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">

            <Grid Margin="20">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- TITLE -->
                <StackPanel Grid.Row="0"
                            Margin="0,8,0,30">

                    <TextBlock Text="ตั้งค่า"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBlock Text="Application Preferences"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="2,6,0,0"/>

                </StackPanel>


                    <!-- MENUS -->
                    <StackPanel Grid.Row="1">

                        <!-- GENERAL -->
                        <Border x:Name="GeneralMenu"
            Background="{DynamicResource SidebarBackground}"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12"
            Cursor="Hand"
            MouseLeftButtonUp="GeneralMenu_Click"
            BorderBrush="Transparent"
            BorderThickness="0">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Opacity"
                        Value="1"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                             Value="True">

                                            <Setter Property="Opacity"
                                Value="0.92"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="⚙"
                       FontSize="20"
                       Margin="0,0,10,0"/>

                                <StackPanel>

                                    <TextBlock Text="ทั่วไป"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                                    <TextBlock Text="General"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryText}"/>

                                </StackPanel>

                            </StackPanel>

                        </Border>

                        <!-- BACKUP -->
                        <Border x:Name="BackupMenu"
            Background="{DynamicResource SidebarBackground}"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12"
            Cursor="Hand"
            MouseLeftButtonUp="BackupMenu_Click"
            BorderBrush="Transparent"
            BorderThickness="0">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Opacity"
                        Value="1"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                             Value="True">

                                            <Setter Property="Opacity"
                                Value="0.92"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="💾"
                       FontSize="20"
                       Margin="0,0,10,0"/>

                                <TextBlock Text="สำรองข้อมูล"
                       FontSize="17"
                       Foreground="{DynamicResource PrimaryText}"
                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <!-- SYSTEM -->
                        <Border x:Name="SystemMenu"
            Background="{DynamicResource SidebarBackground}"
            CornerRadius="18"
            Padding="18"
            Margin="0,0,0,12"
            Cursor="Hand"
            MouseLeftButtonUp="SystemMenu_Click"
            BorderBrush="Transparent"
            BorderThickness="0">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Opacity"
                        Value="1"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                             Value="True">

                                            <Setter Property="Opacity"
                                Value="0.92"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="⌨"
                       FontSize="20"
                       Margin="0,0,10,0"/>

                                <TextBlock Text="ระบบ"
                       FontSize="17"
                       Foreground="{DynamicResource PrimaryText}"
                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                        <!-- ABOUT -->
                        <Border x:Name="AboutMenu"
            Background="{DynamicResource SidebarBackground}"
            CornerRadius="18"
            Padding="18"
            Cursor="Hand"
            MouseLeftButtonUp="AboutMenu_Click"
            BorderBrush="Transparent"
            BorderThickness="0">

                            <Border.Style>

                                <Style TargetType="Border">

                                    <Setter Property="Opacity"
                        Value="1"/>

                                    <Style.Triggers>

                                        <Trigger Property="IsMouseOver"
                             Value="True">

                                            <Setter Property="Opacity"
                                Value="0.92"/>

                                        </Trigger>

                                    </Style.Triggers>

                                </Style>

                            </Border.Style>

                            <StackPanel Orientation="Horizontal">

                                <TextBlock Text="ⓘ"
                       FontSize="20"
                       Margin="0,0,10,0"/>

                                <TextBlock Text="เกี่ยวกับ"
                       FontSize="17"
                       Foreground="{DynamicResource PrimaryText}"
                       VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>
                    <!-- FOOTER -->
                <StackPanel Grid.Row="2"
                            Margin="0,20,0,0">

                    <Separator Margin="0,0,0,16"/>

                    <TextBlock Text="Text Expander v1.0 MVP"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryText}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1">

            <!-- GENERAL PANEL -->
            <ScrollViewer x:Name="GeneralPanel"
              VerticalScrollBarVisibility="Auto">

                <StackPanel Margin="32">

                    <TextBlock Text="General Settings"
                   FontSize="30"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryText}"
                   Margin="0,0,0,28"/>

                    <!-- ENABLE -->
                    <Border Background="{DynamicResource CardBackground}"
                CornerRadius="20"
                Padding="22"
                Margin="0,0,0,18">

                        <DockPanel LastChildFill="False">

                            <!-- TEXT -->
                            <StackPanel DockPanel.Dock="Left">

                                <TextBlock Text="เปิดใช้งาน Text Expansion"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>

                                <TextBlock Text="ระบบจะ replace keyword อัตโนมัติ"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,6,0,0"/>

                            </StackPanel>

                            <!-- SWITCH -->
                            <primitives:ToggleButton Width="74"
                                         Height="36"
                                         Cursor="Hand"
                                         IsChecked="True"
                                         Margin="24,0,0,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Checked="SystemToggle_Checked"
                                         Unchecked="SystemToggle_Unchecked">

                                <primitives:ToggleButton.Template>

                                    <ControlTemplate TargetType="primitives:ToggleButton">

                                        <Grid Width="74"
                                  Height="36">

                                            <!-- BG -->
                                            <Border x:Name="SwitchBg"
                                        CornerRadius="18"
                                        Background="#D6D6D6"/>

                                            <!-- DOT -->
                                            <Border x:Name="SwitchDot"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        Margin="3">

                                                <Border.Effect>

                                                    <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="1"
                                                          Opacity="0.15"/>

                                                </Border.Effect>

                                            </Border>

                                        </Grid>

                                        <ControlTemplate.Triggers>

                                            <!-- ON -->
                                            <Trigger Property="IsChecked"
                                         Value="True">

                                                <Setter TargetName="SwitchBg"
                                            Property="Background"
                                            Value="#3FB950"/>

                                                <Setter TargetName="SwitchDot"
                                            Property="HorizontalAlignment"
                                            Value="Right"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </primitives:ToggleButton.Template>

                            </primitives:ToggleButton>

                        </DockPanel>

                    </Border>

                    <!-- DARK MODE -->
                    <Border Background="{DynamicResource CardBackground}"
                CornerRadius="20"
                Padding="22">

                        <DockPanel LastChildFill="False">

                            <!-- TEXT -->
                            <StackPanel DockPanel.Dock="Left">

                                <TextBlock Text="Dark Mode"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>

                                <TextBlock Text="เปลี่ยนธีมโปรแกรมเป็นโหมดมืด"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,6,0,0"/>

                            </StackPanel>

                            <!-- SWITCH -->
                            <primitives:ToggleButton
                                         x:Name="DarkModeToggle"
                                         Width="74"
                                         Height="36"
                                         Cursor="Hand"
                                         Margin="24,0,0,0"
                                         HorizontalAlignment="Right"
                                         VerticalAlignment="Center"
                                         Checked="DarkModeToggle_Checked"
                                         Unchecked="DarkModeToggle_Unchecked">

                                <primitives:ToggleButton.Template>

                                    <ControlTemplate TargetType="primitives:ToggleButton">

                                        <Grid Width="74"
                                  Height="36">

                                            <!-- BG -->
                                            <Border x:Name="SwitchBg"
                                        CornerRadius="18"
                                        Background="#D6D6D6"/>

                                            <!-- DOT -->
                                            <Border x:Name="SwitchDot"
                                        Width="30"
                                        Height="30"
                                        CornerRadius="15"
                                        Background="White"
                                        HorizontalAlignment="Left"
                                        Margin="3">

                                                <Border.Effect>

                                                    <DropShadowEffect BlurRadius="8"
                                                          ShadowDepth="1"
                                                          Opacity="0.15"/>

                                                </Border.Effect>

                                            </Border>

                                        </Grid>

                                        <ControlTemplate.Triggers>

                                            <!-- ON -->
                                            <Trigger Property="IsChecked"
                                         Value="True">

                                                <Setter TargetName="SwitchBg"
                                            Property="Background"
                                            Value="#3B82F6"/>

                                                <Setter TargetName="SwitchDot"
                                            Property="HorizontalAlignment"
                                            Value="Right"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </primitives:ToggleButton.Template>

                            </primitives:ToggleButton>

                        </DockPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

            <!-- BACKUP PANEL -->
            <ScrollViewer x:Name="BackupPanel"
                          Visibility="Collapsed">

                <StackPanel Margin="36">

                    <!-- TITLE -->
                    <TextBlock Text="Backup"
               FontSize="34"
               FontWeight="Bold"
               Foreground="{DynamicResource PrimaryText}"
               Margin="0,0,0,26"/>

                    <!-- MAIN CARD -->
                    <Border Background="{DynamicResource CardBackground}"
            CornerRadius="24"
            Padding="26"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">

                        <StackPanel>

                            <!-- EXPORT -->
                            <StackPanel>

                                <TextBlock Text="สำรองข้อมูล"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                                <TextBlock Text="สร้างไฟล์สำรองข้อมูลของข้อความทั้งหมด"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,6,0,20"/>

                                <StackPanel Orientation="Horizontal">

                                    <!-- EXPORT BTN -->
                                    <Button Width="170"
                                        Height="42"
                                        HorizontalAlignment="Left"
                                        Margin="0,0,12,0"
                                        Click="ExportButton_Click"
                                        Background="#1677FF"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Cursor="Hand">      

                                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                                            <TextBlock Text="⤴"
                                       FontSize="15"
                                       Margin="0,0,8,0"/>

                                            <TextBlock Text="สร้างข้อมูลสำรอง"/>

                                        </StackPanel>

                                    </Button>
                                    <StackPanel Orientation="Horizontal">
                                    </StackPanel>


                                </StackPanel>

                            </StackPanel>

                            <!-- DIVIDER -->
                            <Separator Margin="0,28,0,28"/>

                            <!-- IMPORT -->
                            <StackPanel>

                                <TextBlock Text="กู้คืนข้อมูล"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                                <TextBlock Text="กู้คืนข้อมูลจากไฟล์สำรอง"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,6,0,20"/>

                                <Button Width="170"
                                    Height="42"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,12,0"
                                    Click="ImportButton_Click"
                                    Background="#1677FF"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="SemiBold"
                                    Cursor="Hand">      

                                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                                        <TextBlock Text="⤵"
                                   FontSize="15"
                                   Margin="0,0,8,0"/>

                                        <TextBlock Text="เลือกไฟล์คืน"/>

                                    </StackPanel>

                                </Button>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- SYSTEM PANEL -->
            <ScrollViewer x:Name="SystemPanel"
              Visibility="Collapsed">

                <StackPanel Margin="36">

                    <!-- TITLE -->
                    <TextBlock Text="System"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryText}"
                   Margin="0,0,0,26"/>

                    <!-- BEFORE EXPAND -->
                    <Border Background="{DynamicResource CardBackground}"
                CornerRadius="24"
                Padding="26"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="Delay ก่อน Expand"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                            <TextBlock Text="กำหนดเวลา delay ก่อน replace Line OA แนะนำ 100"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,6,0,20"/>

                            <StackPanel Orientation="Horizontal">

                                <TextBox x:Name="DelayTextBox"
                             Width="120"
                             Height="42"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Text="100"
                             PreviewTextInput="DelayTextBox_PreviewTextInput"/>

                                <TextBlock Text="ms"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="12,0,18,0"/>

                                <Button Content="บันทึก"
                            Width="100"
                            Height="42"
                            FontWeight="SemiBold"
                            Click="SaveDelayButton_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- BEFORE PASTE -->
                    <Border Background="{DynamicResource CardBackground}"
                CornerRadius="24"
                Padding="26"
                Margin="0,20,0,0"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="Delay ก่อน Paste"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                            <TextBlock Text="กำหนดเวลาก่อนวางข้อความ Line OA แนะนำ 50"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,6,0,20"/>

                            <StackPanel Orientation="Horizontal">

                                <TextBox x:Name="BeforePasteDelayTextBox"
                             Width="120"
                             Height="42"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Text="50"
                             PreviewTextInput="DelayTextBox_PreviewTextInput"/>

                                <TextBlock Text="ms"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="12,0,18,0"/>

                                <Button Content="บันทึก"
                            Width="100"
                            Height="42"
                            FontWeight="SemiBold"
                            Click="SaveBeforePasteDelay_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                    <!-- AFTER PASTE -->
                    <Border Background="{DynamicResource CardBackground}"
                CornerRadius="24"
                Padding="26"
                Margin="0,20,0,0"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="Delay หลัง Paste"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                            <TextBlock Text="กำหนดเวลาหลังวางข้อความ Line OA แนะนำ 30"
                           FontSize="13"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,6,0,20"/>

                            <StackPanel Orientation="Horizontal">

                                <TextBox x:Name="AfterPasteDelayTextBox"
                             Width="120"
                             Height="42"
                             FontSize="16"
                             VerticalContentAlignment="Center"
                             Text="30"
                             PreviewTextInput="DelayTextBox_PreviewTextInput"/>

                                <TextBlock Text="ms"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="12,0,18,0"/>

                                <Button Content="บันทึก"
                            Width="100"
                            Height="42"
                            FontWeight="SemiBold"
                            Click="SaveAfterPasteDelay_Click"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>
            <!-- ABOUT PANEL -->
            <ScrollViewer x:Name="AboutPanel"
              Visibility="Collapsed">

                <StackPanel Margin="36">

                    <!-- TITLE -->
                    <TextBlock Text="About"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="{DynamicResource PrimaryText}"
                   Margin="0,0,0,26"/>

                    <!-- CARD -->
                    <Border Background="{DynamicResource CardBackground}"
                CornerRadius="24"
                Padding="28"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">

                        <StackPanel>

                            <TextBlock Text="TheCopText"
               FontSize="28"
               FontWeight="Bold"
               Foreground="{DynamicResource PrimaryText}"/>

                            <TextBlock Text="Version 1.0 MVP"
               FontSize="14"
               Margin="0,8,0,18"
               Foreground="{DynamicResource SecondaryText}"/>

                            <TextBlock Text="Fast • Lightweight • Smart Expansion"
               FontSize="15"
               FontWeight="SemiBold"
               Foreground="{DynamicResource PrimaryText}"
               Margin="0,0,0,18"/>

                            <Border Height="1"
            Background="{DynamicResource BorderColor}"
            Margin="0,0,0,18"/>

                            <!-- BUILT WITH -->
                            <TextBlock Text="Built with"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="{DynamicResource SecondaryText}"
               Margin="0,0,0,10"/>

                            <WrapPanel Margin="0,0,0,20">

                                <Border Background="{DynamicResource WindowBackground}"
                CornerRadius="12"
                Padding="10,6"
                Margin="0,0,10,10">

                                    <TextBlock Text="C#"
                       FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource WindowBackground}"
                CornerRadius="12"
                Padding="10,6"
                Margin="0,0,10,10">

                                    <TextBlock Text="WPF (.NET)"
                       FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource WindowBackground}"
                CornerRadius="12"
                Padding="10,6"
                Margin="0,0,10,10">

                                    <TextBlock Text="SQLite"
                       FontWeight="SemiBold"/>
                                </Border>

                                <Border Background="{DynamicResource WindowBackground}"
                CornerRadius="12"
                Padding="10,6"
                Margin="0,0,10,10">

                                    <TextBlock Text="MouseKeyHook"
                       FontWeight="SemiBold"/>
                                </Border>

                            </WrapPanel>

                            <Border Height="1"
            Background="{DynamicResource BorderColor}"
            Margin="0,0,0,18"/>

                            <StackPanel>

                                <TextBlock Text="Toggle Expansion: Ctrl + F12"
                   FontSize="14"
                   Foreground="{DynamicResource PrimaryText}"
                   Margin="0,0,0,8"/>

                                <TextBlock Text="Developed by Adisorn With Codex GPT"
                   FontSize="14"
                   Foreground="{DynamicResource SecondaryText}"/>

                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>