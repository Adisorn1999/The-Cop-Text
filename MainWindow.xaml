<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        PreviewKeyDown="Window_PreviewKeyDown"
        mc:Ignorable="d"
        Title="TheCopText"
        Width="1280"
        Height="760"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">

    <Grid>

        <!-- COLUMNS -->
        <Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <ColumnDefinition Width="220"/>

            <!-- LIST -->
            <ColumnDefinition Width="340"/>

            <!-- EDITOR -->
            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- TITLE -->
                <StackPanel Grid.Row="0"
                            Margin="0,10,0,28">

                    <TextBlock Text="TheCopText"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBlock Text="AutoText Manager"
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="2,6,0,0"/>

                </StackPanel>

                <!-- PROFILE -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="22"
                        Padding="20"
                        Margin="0,0,0,26">

                    <StackPanel>

                        <TextBlock Text="PROFILE ปัจจุบัน"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryText}"/>

                        <TextBlock x:Name="ProfileNameText"
                                   Text="snippets.db"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- MENU -->
                <StackPanel Grid.Row="2">

                    <!-- SYSTEM -->
                    <Border CornerRadius="18"
        Background="{DynamicResource CardBackground}"
        Padding="18"
        Margin="0,14,0,0">

                        <StackPanel>

                            <TextBlock Text="สถานะระบบ"
                   FontSize="15"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}"/>

                            <TextBlock Text="เปิด / ปิด (กด Ctr+F12)"
                   FontSize="12"
                   Margin="0,4,0,14"
                   Foreground="{DynamicResource SecondaryText}"/>

                            <ToggleButton x:Name="SystemToggle"
              Width="74"
              Height="36"
              Cursor="Hand"
              IsChecked="True"
              Checked="SystemToggle_Checked"
              Unchecked="SystemToggle_Unchecked">

                                <ToggleButton.Template>

                                    <ControlTemplate TargetType="ToggleButton">

                                        <Grid Width="74"
                  Height="36">

                                            <!-- BACKGROUND -->
                                            <Border x:Name="SwitchBackground"
                        CornerRadius="18"
                        Background="#D6D6D6"/>

                                            <!-- DOT -->
                                            <Border x:Name="SwitchDot"
                        Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="White"
                        HorizontalAlignment="Left"
                        Margin="3">

                                                <Border.Effect>

                                                    <DropShadowEffect BlurRadius="8"
                                          ShadowDepth="1"
                                          Opacity="0.15"/>

                                                </Border.Effect>

                                            </Border>

                                        </Grid>

                                        <!-- TRIGGERS -->
                                        <ControlTemplate.Triggers>

                                            <!-- ON -->
                                            <Trigger Property="IsChecked"
                         Value="True">

                                                <Setter TargetName="SwitchBackground"
                            Property="Background"
                            Value="#49D16D"/>

                                                <Setter TargetName="SwitchDot"
                            Property="HorizontalAlignment"
                            Value="Right"/>

                                            </Trigger>

                                            <!-- HOVER -->
                                            <Trigger Property="IsMouseOver"
                         Value="True">

                                                <Setter TargetName="SwitchBackground"
                            Property="Opacity"
                            Value="0.92"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>

                                </ToggleButton.Template>

                            </ToggleButton>

                        </StackPanel>

                    </Border>

                    <!-- SETTINGS -->
                    <Border x:Name="SettingsMenu"
        Padding="16"
        Margin="0,8,0,0"
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        CornerRadius="18"
        Cursor="Hand"
        MouseLeftButtonUp="SettingsButton_Click">

                        <Border.Style>

                            <Style TargetType="Border">

                                <Setter Property="Background"
                    Value="{DynamicResource CardBackground}"/>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver"
                         Value="True">

                                        <Setter Property="Background"
                            Value="{DynamicResource MenuActiveBackground}"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>

                        </Border.Style>

                        <StackPanel Orientation="Horizontal"
                VerticalAlignment="Center">

                            <!-- ICON -->
                            <Border Width="42"
                Height="42"
                CornerRadius="12"
                Background="#4A90E2">

                                <TextBlock Text="⚙"
                       FontSize="18"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                            </Border>

                            <!-- TEXT -->
                            <StackPanel Margin="25,0,0,0"
                    VerticalAlignment="Center">
                                <TextBlock Text="ตั้งค่า"
                       FontSize="25"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}" RenderTransformOrigin="1.099,0.629"/>



                            </StackPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

                <!-- FOOTER -->
                <StackPanel Grid.Row="3"
                            Margin="0,20,0,8">

                    <Separator Margin="0,0,0,16"/>

                    <TextBlock Text="The_CopTextV1.0"
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryText}"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- LIST PANEL -->
        <Border Grid.Column="2"
                Background="{DynamicResource WindowBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,1,0">

            <Grid Margin="18">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>

                </Grid.RowDefinitions>

                <!-- SEARCH -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,18">

                    <TextBlock Text="ค้นหา"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="4,0,0,8"/>

                    <Border Background="{DynamicResource CardBackground}"
                            CornerRadius="16"
                            Padding="6">

                        <TextBox x:Name="SearchTextBox"
                                 TextChanged="SearchTextBox_TextChanged"
                                 Height="44"
                                 FontSize="15"
                                 Padding="14,0"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryText}"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>

                    </Border>

                </StackPanel>

                <!-- LIST -->
                <ListBox x:Name="SnippetListBox"
                         Grid.Row="1"
                         SelectionChanged="SnippetListBox_SelectionChanged"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <!-- ITEM STYLE -->
                    <ListBox.ItemContainerStyle>

                        <Style TargetType="ListBoxItem">

                            <Setter Property="Padding"
                                    Value="0"/>

                            <Setter Property="Margin"
                                    Value="0"/>

                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>

                            <Setter Property="FocusVisualStyle"
                                    Value="{x:Null}"/>

                            <Setter Property="Template">

                                <Setter.Value>

                                    <ControlTemplate TargetType="ListBoxItem">

                                        <Border Background="Transparent">

                                            <ContentPresenter/>

                                        </Border>

                                    </ControlTemplate>

                                </Setter.Value>

                            </Setter>

                        </Style>

                    </ListBox.ItemContainerStyle>

                    <!-- CARD -->
                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <Border x:Name="CardBorder"
                                    Background="{DynamicResource CardBackground}"
                                    CornerRadius="18"
                                    Padding="18"
                                    Margin="0,0,0,14"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    MinHeight="90">

                                <StackPanel>

                                    <TextBlock Text="{Binding Keyword}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"/>

                                    <TextBlock Text="{Binding Content}"
                                               Margin="0,8,0,0"
                                               FontSize="13"
                                               Foreground="{DynamicResource SecondaryText}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="40"/>

                                </StackPanel>

                            </Border>

                            <!-- STATES -->
                            <DataTemplate.Triggers>

                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"
                                             Value="True">

                                    <Setter TargetName="CardBorder"
                                            Property="Background"
                                            Value="{DynamicResource MenuActiveBackground}"/>

                                    <Setter TargetName="CardBorder"
                                            Property="BorderThickness"
                                            Value="2"/>

                                </DataTrigger>

                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsMouseOver}"
                                             Value="True">

                                    <Setter TargetName="CardBorder"
                                            Property="Background"
                                            Value="{DynamicResource MenuActiveBackground}"/>

                                </DataTrigger>

                            </DataTemplate.Triggers>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </Grid>

        </Border>

        <!-- EDITOR -->
        <Border Grid.Column="1"
                Background="{DynamicResource CardBackground}">

            <Grid Margin="28">

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- KEYWORD -->
                <StackPanel Grid.Row="0">

                    <TextBlock Text="KEYWORD"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBox x:Name="KeywordTextBox"
                             Height="52"
                             FontSize="18"
                             Padding="14"
                             Margin="0,10,0,24"
                             Foreground="{DynamicResource PrimaryText}"
                             Background="{DynamicResource WindowBackground}"
                             VerticalContentAlignment="Center"/>

                </StackPanel>

                <!-- CONTENT -->
                <Grid Grid.Row="1">

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="ข้อความที่แทน"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBox x:Name="ContentTextBox"
                             Grid.Row="1"
                             Margin="0,10,0,0"
                             FontSize="15"
                             Padding="16"
                             Foreground="{DynamicResource PrimaryText}"
                             Background="{DynamicResource WindowBackground}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>

                </Grid>

                <!-- SAVE -->
                <Button Grid.Row="3"
                        Content="บันทึก"
                        Click="SaveButton_Click"
                        Height="52"
                        Margin="0,24,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="{DynamicResource BlueButton}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

                <!-- DELETE -->
                <Button Grid.Row="4"
                        Content="ลบ"
                        Click="DeleteButton_Click"
                        Height="52"
                        Margin="0,14,0,0"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="{DynamicResource RedButton}"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"/>

            </Grid>

        </Border>

    </Grid>

</Window>