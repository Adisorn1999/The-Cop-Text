<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MAIN -->
    <SolidColorBrush x:Key="WindowBackground"
                     Color="#F7F7F7"/>

    <!-- SIDEBAR -->
    <SolidColorBrush x:Key="SidebarBackground"
                     Color="#FFFFFF"/>

    <!-- CARD -->
    <SolidColorBrush x:Key="CardBackground"
                     Color="#FFFFFF"/>

    <!-- BORDER -->
    <SolidColorBrush x:Key="BorderColor"
                     Color="#EAEAEA"/>

    <!-- TEXT -->
    <SolidColorBrush x:Key="PrimaryText"
                     Color="#111111"/>

    <SolidColorBrush x:Key="SecondaryText"
                     Color="#777777"/>

    <!-- BUTTON -->
    <SolidColorBrush x:Key="BlueButton"
                     Color="#4A90E2"/>

    <SolidColorBrush x:Key="RedButton"
                     Color="#FF5A5F"/>
    <!-- TEXT -->
    <SolidColorBrush x:Key="MenuActiveBackground"
                 Color="#EEF5FF"/>
    <Color x:Key="SelectedCardColor">
        #EAF2FF
    </Color>

    <SolidColorBrush x:Key="SelectedCardBrush"
                 Color="{StaticResource SelectedCardColor}"/>
    <SolidColorBrush x:Key="SelectedPrimaryText"
                 Color="#111827"/>

    <SolidColorBrush x:Key="SelectedSecondaryText"
                 Color="#4B5563"/>
</ResourceDictionary>